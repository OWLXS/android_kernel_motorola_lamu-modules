CONFIG_OEM_TCPC_HUSB320=m
CONFIG_OEM_TCPC_AW35616=m
CONFIG_OEM_TCPC_PD_SC2150=m
CONFIG_OEM_TCPC_PD_CPS8851=m
CONFIG_OEM_TCPC_PD_AW35615=m
