CONFIG_OEM_PROJECT=y
CONFIG_PROJECT_LAMU=y
CONFIG_MTK_REAR_ALS_HUB=y
CONFIG_MTK_REAR_FLK_HUB=y
CONFIG_MTK_FLIPTWIST_HUB=y
CONFIG_MTK_CHOPCHOP_HUB=y
CONFIG_MTK_SIGMOVE_HUB=y
CONFIG_MTK_FLIP_HUB=y
CONFIG_MTK_TAP_TAP_HUB=n
CONFIG_MTK_LCM_PHYSICAL_ROTATION="0"
CONFIG_LCM_HEIGHT="2400"
CONFIG_LCM_WIDTH="1080"
CONFIG_DRM_PANEL_BOE_ICNL9922C_VDO=m
CONFIG_DRM_PANEL_TXD_ILI9883C_VDO=m
CONFIG_DRM_PANEL_TM_TD4376_VDO=m
CONFIG_DRM_PANEL_DJN_NT36672S_VDO=m
CONFIG_DRM_PANEL_TIANMA_NT36528A_VDO=m
CONFIG_DRM_PANEL_DIJIN_TD4160_VDO=m
CONFIG_OEM_TINNO_CHARGER=m
CONFIG_OEM_SWITCH_CHARGER=m
CONFIG_OEM_SWITCH_CHARGER_SGM41542=m
CONFIG_OEM_SWITCH_CHARGER_CX2589X=m
CONFIG_OEM_TCPC=m
CONFIG_OEM_TCPC_HUSB320=m
CONFIG_OEM_TCPC_AW35616=m
CONFIG_OEM_TCPC_PD_SC2150=m
CONFIG_OEM_TCPC_PD_CPS8851=m
CONFIG_OEM_TCPC_PD_AW35615=m
CONFIG_SND_SOC_FS1815=m
CONFIG_OEM_QC_LOGIC=m
CONFIG_OEM_QC_LOGIC_Z350=m
CONFIG_OEM_QC_LOGIC_WT6670F=m
CONFIG_OEM_CHARGER_PUMP=m
CONFIG_OEM_CHARGER_PUMP_CPS2011S=m
CONFIG_OEM_CHARGER_PUMP_SGM41600S=m
CONFIG_OEM_TURBO_CHARGER=m
CONFIG_OEM_TINNO_CHARGE_MISC=m
CONFIG_AWINIC_SAR=m
CONFIG_HX9031_SAR=m
CONFIG_OEM_HVDCP_ALGO=m
CONFIG_OEM_PDC_ALGO=m
CONFIG_OEM_ANT_DET=m
CONFIG_PE50_FFC_SUPPORT=m
CONFIG_TRUSTONIC_TEE_SUPPORT=m
CONFIG_TEE=m
CONFIG_MTK_TEE_GP_SUPPORT=y

CONFIG_OEM_DRE_MODE=m

# TEST 27/09: swapped kCFI for ThinLTO (must match gki_defconfig -- the Bazel
# ack target that builds Image.gz never reads this overlay, so modules need
# to mirror whatever gki_defconfig has or they mismatch the Image and panic
# at first modprobe, same failure mode as the old kCFI/no-kCFI mismatch).
# Watch for the old GOT-relocation bug (R_AARCH64_ADR_GOT_PAGE /
# R_AARCH64_LD64_GOT_LO12_NC) at the Image<->module boundary -- readelf -r
# on every .ko before flashing, per kernellamu-cfi-reativado-e-renderengine-vulkan.
# CONFIG_CFI_CLANG is not set
CONFIG_LTO_CLANG_THIN=y

# ktchbst (drivers/misc/mediatek/ktchbst) is redundant with the newer
# performance/touch_boost module (same input handler, same /proc/touch_boost
# dir, competing freq_qos requests) — see mgk_64.bzl, which already excludes
# ktchbst.ko from the dist/copy list. Disabling the Kconfig too so Kbuild
# stops compiling it at all; otherwise Bazel's outs= hermeticity check fails
# with "kernel modules are built but not copied" since ktchbst.ko still gets
# built even though it's no longer declared as an expected output.
# CONFIG_MTK_KTCHBST is not set

# TEST 27/09: must match gki_defconfig (HZ_1000 instead of the GKI default
# HZ_250) -- same reasoning as the CFI/LTO overlay mirror above: the ack
# target that builds Image.gz never reads this file, but module builds do.
# CONFIG_HZ_250 is not set
CONFIG_HZ_1000=y
